# THADAM TN — Environment Configuration
# Explore Beyond the Famous. Empower the Local.

# Supabase Credentials (Required for remote backend & auth)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional External Map & AI Services
GOOGLE_MAPS_API_KEY=
AI_API_URL=
AI_API_KEY=

# THADAM AI Backend URL (FastAPI - run: cd backend && uvicorn app:app --reload --host 0.0.0.0 --port 8000)
EXPO_PUBLIC_THADAM_API_URL=http://localhost:8000

# Service Operating Modes: 'real' | 'demo'
# When set to 'demo', THADAM operates using verified local seed data and in-memory Realtime event bus
MAP_MODE=demo
AI_MODE=demo
FACILITY_MODE=demo

# Push Notifications (Optional)
PUSH_NOTIFICATION_CONFIG=
